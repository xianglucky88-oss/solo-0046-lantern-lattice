  "workflows": [
    {
      "id": "tiled",
      "name": "分页烘焙与离线导入取样",
      "entry": "POST /v1/build（带 MaxTextureWidth/Height）、POST /v1/import、GET /v1/artifacts/{digest}/sample",
      "success": "每页不超过设备纹理上限且可单独上传；导入核对尺寸、边界、完整覆盖与重复像素一致性，逻辑双线性取样与原条带一致。",
      "failure": "上限小于 2、缺少声明页、片段越界、覆盖空洞或重复像素冲突均在导入阶段拒绝。",
      "verification": "python3 -B tools/verify.py tiled",
      "steps": [
        "POST /v1/build（带 MaxTextureWidth/Height）",
        "POST /v1/import",
        "GET /v1/artifacts/{digest}/sample"
      ],
