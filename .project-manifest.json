        "internal-vault-write",
        "internal-vault-stage",
        "internal-vault-read",
        "internal-service-download"
      ]
    },
    {
      "id": "resume",
      "name": "灯具版本续烘与离线补件",
      "entry": "POST /v1/revisions、GET /v1/patches/{id}、cmd/offline",
      "success": "按稳定标识增删改点光源，重求集受额度约束，仅遮挡点不占额度；新包与全量烘焙字节一致，可凭补件、旧回执和旧包离线重建。",
      "failure": "超额、基版缺失或损坏、身份或摘要不符时拒绝，且不产生可下载或可续烘的新版本，已有版本仍可复取。",
      "verification": "python3 -B tools/verify.py resume",
      "steps": [
        "POST /v1/build（Resumable）取得灯具版本身份",
        "POST /v1/revisions 按稳定标识续烘并取得补件入口",
        "cmd/offline 用补件、旧回执和旧包离线重建字节相同的新包"
      ],
