    {
      "id": "product",
      "name": "遮挡探针烘焙",
      "entry": "POST /v1/build",
      "success": "点光源累积到六方向，插值剔除不可见邻点，输出可解码 PNG 与空间布局。",
      "failure": "非法网格、光源或无体积遮挡盒返回 422。",
      "verification": "python3 -B tools/verify.py product",
      "steps": [
        "POST /v1/build",
        "点光源累积到六方向，插值剔除不可见邻点，输出可解码 PNG 与空间布局。"
      ],
